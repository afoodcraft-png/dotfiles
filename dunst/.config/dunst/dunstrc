[global]
    monitor = 0
    follow = mouse

    # Posisi — pojok kanan bawah
    origin = bottom-right
    offset = (12, 12)

    # Ukuran notif
    width = 300
    height = (0, 100)
    padding = 12
    horizontal_padding = 14

    # Font
    font = JetBrainsMono Nerd Font 10

    # Border
    frame_width = 2
    frame_color = "#cba6f7"
    corner_radius = 8

    # Separator antar notif
    separator_height = 2
    separator_color = "#45475a"

    # Timeout default (ms)
    idle_threshold = 120

    # Icon
    icon_position = left
    min_icon_size = 24
    max_icon_size = 32

    # Markup
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    word_wrap = true

    # Animasi
    show_age_threshold = 60
    shrink = false

    # Mouse
    mouse_left_click = close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    frame_color = "#45475a"
    timeout = 4

[urgency_normal]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    frame_color = "#cba6f7"
    timeout = 6

[urgency_critical]
    background = "#1e1e2e"
    foreground = "#f38ba8"
    frame_color = "#f38ba8"
    timeout = 0
